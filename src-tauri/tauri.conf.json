{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "VolleyReg",
  "version": "1.0.0",
  "identifier": "ru.zgu.volleyreg",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build:tauri"
  },
  "app": {
    "windows": [
      {
        "title": "VolleyReg — участницы Первенства ЗГУ",
        "width": 1280,
        "height": 860,
        "resizable": true,
        "fullscreen": false,
        "minWidth": 380,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}