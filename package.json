{
  "name": "volleyreg-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:pages": "tsc -b && vite build --mode pages && node -e \"require('fs').copyFileSync('dist/index.html','dist/404.html')\"",
    "build:tauri": "tsc -b && vite build --mode tauri",
    "dev:https": "vite --mode https",
    "tauri": "tauri",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "generate-api": "node scripts/generate-api.mjs"
  },
  "dependencies": {
    "@huggingface/transformers": "3.5.1",
    "@reduxjs/toolkit": "2.5.0",
    "axios": "1.7.9",
    "bootstrap": "5.3.3",
    "react": "18.3.1",
    "react-bootstrap": "2.10.5",
    "react-dom": "18.3.1",
    "react-redux": "9.1.2",
    "react-router-dom": "6.28.0"
  },
  "devDependencies": {
    "@eslint/js": "9.15.0",
    "@tauri-apps/cli": "2.5.0",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-basic-ssl": "1.2.0",
    "@vitejs/plugin-react": "4.3.4",
    "eslint": "9.15.0",
    "eslint-plugin-react-hooks": "5.0.0",
    "eslint-plugin-react-refresh": "0.4.14",
    "globals": "15.12.0",
    "swagger-typescript-api": "13.0.23",
    "typescript": "5.6.3",
    "typescript-eslint": "8.15.0",
    "vite": "5.4.11",
    "vite-plugin-pwa": "0.21.1",
    "vitest": "2.1.8"
  }
}
